{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://am-system.local/price-feed/v1/quotes.schema.json",
  "title": "Пакет снимков цен",
  "description": "POST /api/marketdata/feed/v1/quotes. Описание полей — в README.md рядом.",
  "type": "object",
  "required": ["source", "quotes"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "description": "Откуда цены: короткий код источника, латиница в нижнем регистре, цифры, «-» и «_».",
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,32}$"
    },
    "quotes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/quote" }
    }
  },
  "$defs": {
    "price": {
      "description": "Облигация — чистая цена в % от номинала; пай — цена в валюте за пай. До 6 знаков после запятой.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "quote": {
      "type": "object",
      "required": ["code", "time"],
      "additionalProperties": false,
      "minProperties": 3,
      "properties": {
        "code": {
          "description": "Код бумаги на бирже (SECID) или ISIN. Бумага должна быть в справочнике.",
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "time": {
          "description": "Момент, к которому относятся цены. RFC 3339 со смещением: 2026-10-27T11:05:00+03:00.",
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
        },
        "vwap": { "$ref": "#/$defs/price", "description": "Средневзвешенная по объёму цена сделок с начала торгового дня до time." },
        "last": { "$ref": "#/$defs/price", "description": "Цена последней сделки до time." },
        "bid": { "$ref": "#/$defs/price", "description": "Лучшая цена покупки на time." },
        "ask": { "$ref": "#/$defs/price", "description": "Лучшая цена продажи на time." },
        "close": { "$ref": "#/$defs/price", "description": "Цена закрытия торгового дня." },
        "market_price": { "$ref": "#/$defs/price", "description": "Рыночная цена биржи." },
        "admitted_quote": { "$ref": "#/$defs/price", "description": "Признаваемая котировка биржи." }
      }
    }
  }
}
