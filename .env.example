# Скопируйте в .env и при необходимости поменяйте.
# Все значения — только для локальной разработки. Для виртуальной машины .env
# собирает scripts/vm_config.py (README, «Развёртывание на виртуальной машине»).

GATEWAY_PORT=8080

POSTGRES_PASSWORD=postgres-dev
KEYCLOAK_DB_PASSWORD=keycloak-dev
SERVICES_DB_PASSWORD=services-dev

KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin-dev

# Секрет служебной учётки сервиса portfolio в Keycloak (совпадает с realm для разработки).
PORTFOLIO_KEYCLOAK_SECRET=portfolio-dev-secret
