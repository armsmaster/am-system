{
  "name": "am-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:shell": "npm run dev -w @am/shell",
    "dev:admin": "npm run dev -w @am/mfe-admin",
    "dev:audit": "npm run dev -w @am/mfe-audit",
    "dev:refdata": "npm run dev -w @am/mfe-refdata",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "^2.9.2",
    "@rsbuild/core": "^2.2.14",
    "@rsbuild/plugin-react": "^2.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
