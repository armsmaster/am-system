{
  "realm": "am",
  "displayName": "AM System",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "offlineSessionIdleTimeout": 604800,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 2592000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru",
    "en"
  ],
  "defaultLocale": "ru",
  "roles": {
    "realm": [
      {
        "name": "trading",
        "description": "Трейдинг"
      },
      {
        "name": "operations",
        "description": "Сопровождение"
      },
      {
        "name": "risk",
        "description": "Риск-менеджмент: рейтинги, классификаторы, лимиты"
      },
      {
        "name": "admin",
        "description": "Администратор: видит всё и может всё"
      },
      {
        "name": "price_feed",
        "description": "Скрипт цен: присылает цены и OHLC-бары в marketdata"
      },
      {
        "name": "trade_feed",
        "description": "Скрипт сделок: присылает пакеты сделок в booking и видит все портфели (служебная учётная запись)."
      },
      {
        "name": "statement_feed",
        "description": "Скрипт выписок брокера: присылает выписки по счетам в reconciliation и видит все счета (служебная учётная запись)."
      },
      {
        "name": "close_day",
        "description": "Закрывает день фонда в booking — только служебная учётная запись сервиса сверки."
      },
      {
        "name": "fund_reader",
        "description": "Читает позиции, СЧА и сделки любого фонда — только служебная учётная запись сервиса лимитов."
      }
    ]
  },
